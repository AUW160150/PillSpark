# --- Nicrron (required for live extraction; redeem COLUMBIA26 at https://nicrron.ai/redeem?code=COLUMBIA26) ---
NICRRON_API_KEY=sk-af-...
NICRRON_BASE_URL=https://api.nicrron.ai/v1
# primary vision model + second-opinion model (any vision-capable id from GET /v1/models)
PILLSPARK_MODEL_PRIMARY=anthropic/claude-sonnet-5
PILLSPARK_MODEL_SECOND=openai/gpt-5.4-mini
PILLSPARK_PASSES=3
# live | mock   (mock = perturbed ground truth, no network LLM; auto-selected when key missing)
LLM_MODE=live

# --- Block Convey PRISM (https://prism.blockconvey.com → Settings → Project) ---
PRISMTRACE_HOST=https://prism.blockconvey.com
PRISMTRACE_PROJECT_ID=00000000-0000-0000-0000-000000000000
PRISMTRACE_API_KEY=pt-sk-...

# --- thresholds ---
PILLSPARK_VERIFIED_MIN=0.90
PILLSPARK_REVIEW_MIN=0.70
